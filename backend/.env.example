# Copy to .env in this folder (never commit .env)
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace_with_at_least_16_random_chars
JWT_EXPIRES_IN=7d
JWT_EXPIRES_ADMIN=8h
ADMIN_EMAIL=admin@forever.com
ADMIN_PASSWORD=admin123@

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Required to expose /status and /metrics (send as header x-ops-token)
METRICS_TOKEN=replace_with_ops_token

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloud_secret

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com

INSTANCE_ID=local
FRONTEND_URL=http://localhost:5173

# Optional SMTP — if unset, emails are logged to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
